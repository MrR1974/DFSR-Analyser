<?xml version="1.0" encoding="UTF-8"?>
<!--
  DFSR Analyser's installer (WiX 5). Built by tools/New-Installer.ps1, which publishes the app and the
  dfsra CLI self-contained into one folder and passes it in as PublishDir.

  Per-user by design. Everything goes under the user's local application data and HKEY_CURRENT_USER,
  so installing needs no administrator rights, and a self-contained build needs no .NET runtime on the
  machine.

  - Program files: %LOCALAPPDATA%\Programs\DFSR Analyser (the folder Windows uses for per-user apps).
  - Start menu: one shortcut, "DFSR Analyser".
  - PATH: the program folder is appended to the user's PATH, so dfsra.exe runs from any console.
    New consoles see it; already-open ones do not.
  - Left alone on uninstall: cases (wherever the user created them) and the settings file in
    %LOCALAPPDATA%\DfsrAnalyser (recent cases, UTC/local choice). Both are the user's data.

  The payload is harvested with WiX 5's Files element, so a new DLL in the publish output needs no edit
  here. Component GUIDs for harvested files are generated from their paths, which stay stable between
  versions, so upgrades replace files cleanly.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">

  <Package
      Name="DFSR Analyser"
      Manufacturer="Mark Renoden"
      Version="$(var.Version)"
      UpgradeCode="9F6DE4EA-9BCB-4432-89BB-D04FB3512677"
      Scope="perUser"
      Compressed="yes">

    <SummaryInformation Description="DFSR debug log analyser" />

    <!-- A newer version replaces the old one; installing an older one over a newer is refused. -->
    <MajorUpgrade DowngradeErrorMessage="A newer version of DFSR Analyser is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="AppIcon.ico" SourceFile="$(var.IconFile)" />
    <Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
    <Property Id="ARPNOREPAIR" Value="1" />
    <Property Id="ARPCOMMENTS" Value="Imports or collects DFSR debug logs and charts event rates over time." />

    <StandardDirectory Id="LocalAppDataFolder">
      <Directory Id="PerUserPrograms" Name="Programs">
        <Directory Id="INSTALLFOLDER" Name="DFSR Analyser" />
      </Directory>
    </StandardDirectory>

    <Feature Id="Main" Title="DFSR Analyser" Level="1">
      <ComponentGroupRef Id="ProgramFiles" />
      <ComponentRef Id="StartMenuShortcut" />
      <ComponentRef Id="UserPath" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="ProgramFiles" Directory="INSTALLFOLDER">
      <Files Include="$(var.PublishDir)\**" />
    </ComponentGroup>
  </Fragment>

  <Fragment>
    <!--
      A per-user shortcut needs a registry key path (a shortcut is not a file it can key on). The
      RemoveFolder entries take the program folders away again on uninstall when they are empty.
    -->
    <StandardDirectory Id="ProgramMenuFolder">
      <Component Id="StartMenuShortcut" Guid="4A770269-4221-4174-9559-9CD41427CF2A">
        <Shortcut Id="AppShortcut"
                  Name="DFSR Analyser"
                  Description="Analyse DFSR debug logs"
                  Target="[INSTALLFOLDER]DfsrAnalyser.exe"
                  WorkingDirectory="INSTALLFOLDER" />
        <RemoveFolder Id="RemoveInstallFolder" Directory="INSTALLFOLDER" On="uninstall" />
        <RemoveFolder Id="RemovePerUserPrograms" Directory="PerUserPrograms" On="uninstall" />
        <RegistryValue Root="HKCU" Key="Software\DfsrAnalyser" Name="Installed" Type="integer" Value="1" KeyPath="yes" />
      </Component>
    </StandardDirectory>
  </Fragment>

  <Fragment>
    <Component Id="UserPath" Directory="INSTALLFOLDER" Guid="35BB606B-096C-4C71-BA15-F9EDC0441155">
      <Environment Id="UserPathEntry" Name="PATH" Value="[INSTALLFOLDER]" Part="last" Action="set" System="no" Permanent="no" />
      <RegistryValue Root="HKCU" Key="Software\DfsrAnalyser" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
    </Component>
  </Fragment>

</Wix>
