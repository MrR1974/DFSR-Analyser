<Window x:Class="DfsrAnalyser.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DfsrAnalyser.App.ViewModels"
        xmlns:ctl="clr-namespace:DfsrAnalyser.App.Controls"
        xmlns:sp="clr-namespace:ScottPlot.WPF;assembly=ScottPlot.WPF"
        Title="{Binding Title}" Width="1500" Height="950" MinWidth="900" MinHeight="600"
        Background="White">

    <Window.InputBindings>
        <KeyBinding Key="O" Modifiers="Control" Command="{Binding OpenCaseCommand}" />
        <KeyBinding Key="I" Modifiers="Control" Command="{Binding ImportFilesCommand}" />
        <KeyBinding Key="Back" Modifiers="Alt" Command="{Binding ZoomOutCommand}" />
    </Window.InputBindings>

    <Grid>
        <DockPanel>
            <!-- ================= Menu ================= -->
            <Menu DockPanel.Dock="Top" Background="White">
                <MenuItem Header="_File">
                    <MenuItem Header="_New case…" Command="{Binding NewCaseCommand}" />
                    <MenuItem Header="_Open case…" Command="{Binding OpenCaseCommand}" InputGestureText="Ctrl+O" />
                    <MenuItem Header="_Recent cases" ItemsSource="{Binding RecentCases}">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                                <Setter Property="Header" Value="{Binding}" />
                                <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Setter Property="CommandParameter" Value="{Binding}" />
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Import _files…" Command="{Binding ImportFilesCommand}" InputGestureText="Ctrl+I" IsEnabled="{Binding IsCaseOpen}" />
                    <MenuItem Header="Import fol_der…" Command="{Binding ImportFolderCommand}" IsEnabled="{Binding IsCaseOpen}" />
                    <Separator />
                    <MenuItem Header="E_xit" Click="OnExit" />
                </MenuItem>
                <MenuItem Header="_Collect" IsEnabled="{Binding IsCaseOpen}">
                    <MenuItem Header="_Collect from servers…" Command="{Binding OpenCollectCommand}" />
                    <MenuItem Header="_Top up" ItemsSource="{Binding ProfileNames}">
                        <MenuItem.ItemContainerStyle>
                            <Style TargetType="MenuItem">
                                <Setter Property="Header" Value="{Binding}" />
                                <Setter Property="Command" Value="{Binding DataContext.TopUpCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                <Setter Property="CommandParameter" Value="{Binding}" />
                            </Style>
                        </MenuItem.ItemContainerStyle>
                    </MenuItem>
                    <Separator />
                    <MenuItem Header="Import _event log (.evtx)…" Command="{Binding ImportEventLogFileCommand}" />
                </MenuItem>
                <MenuItem Header="_Rules" IsEnabled="{Binding IsCaseOpen}">
                    <MenuItem Header="_Edit rules file…" Command="{Binding EditRulesCommand}" />
                    <MenuItem Header="_Re-apply rules" Command="{Binding ReapplyRulesCommand}" />
                </MenuItem>
                <MenuItem Header="_View">
                    <MenuItem Header="Show _hidden categories" IsCheckable="True" IsChecked="{Binding ShowHidden}" />
                    <MenuItem Header="Show _local time (instead of UTC)" IsCheckable="True" IsChecked="{Binding UseLocalTime}" />
                </MenuItem>
            </Menu>

            <!-- ================= Toolbar ================= -->
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Background="{StaticResource PaneBackground}" Padding="8,5,8,2">
                <WrapPanel IsEnabled="{Binding IsCaseOpen}">
                    <WrapPanel.Resources>
                        <Style TargetType="DatePicker">
                            <Setter Property="Width" Value="112" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                        </Style>
                        <Style x:Key="TimeBox" TargetType="TextBox">
                            <Setter Property="Width" Value="86" />
                            <Setter Property="Margin" Value="4,0,0,0" />
                            <Setter Property="VerticalAlignment" Value="Center" />
                            <Setter Property="VerticalContentAlignment" Value="Center" />
                            <Setter Property="ToolTip" Value="HH:mm, HH:mm:ss or HH:mm:ss.fff — press Enter to apply" />
                        </Style>
                    </WrapPanel.Resources>
                    <WrapPanel.InputBindings>
                        <KeyBinding Key="Enter" Command="{Binding ApplyTimeRangeCommand}" />
                    </WrapPanel.InputBindings>
                    <TextBlock Text="From" Style="{StaticResource ToolLabel}" Margin="0,0,4,0" />
                    <DatePicker SelectedDate="{Binding FromDate}" />
                    <TextBox Style="{StaticResource TimeBox}" Text="{Binding FromTime, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock Text="To" Style="{StaticResource ToolLabel}" />
                    <DatePicker SelectedDate="{Binding ToDate}" />
                    <TextBox Style="{StaticResource TimeBox}" Text="{Binding ToTime, UpdateSourceTrigger=PropertyChanged}" />
                    <Button Content="Apply" Margin="8,0,0,0" Padding="12,1" VerticalAlignment="Center" Command="{Binding ApplyTimeRangeCommand}"
                            ToolTip="Filter to this range (From inclusive, To exclusive), in the display time zone" />
                    <TextBlock Text="Last of the logs:" Style="{StaticResource ToolLabel}" Margin="14,0,4,0" />
                    <Button Content="15 min" VerticalAlignment="Center" Style="{StaticResource LinkButton}" Command="{Binding LastOfLogsCommand}" CommandParameter="15" />
                    <Button Content="1 h" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource LinkButton}" Command="{Binding LastOfLogsCommand}" CommandParameter="60" />
                    <Button Content="24 h" Margin="8,0,0,0" VerticalAlignment="Center" Style="{StaticResource LinkButton}" Command="{Binding LastOfLogsCommand}" CommandParameter="1440" />
                    <Button Content="Zoom out" Margin="14,0,0,0" VerticalAlignment="Center" Style="{StaticResource LinkButton}"
                            Command="{Binding ZoomOutCommand}" IsEnabled="{Binding CanZoomOut}" ToolTip="Back to the previous time range (Alt+Backspace, or right-click the chart)" />
                    <Button Content="All time" Margin="10,0,0,0" VerticalAlignment="Center" Style="{StaticResource LinkButton}"
                            Command="{Binding ResetTimeCommand}" IsEnabled="{Binding HasTimeFilter}" />
                    <TextBlock Text="{Binding CaseSpanText}" Style="{StaticResource ToolLabel}" Margin="14,0,0,0" />
                    <TextBlock Text="{Binding RangeError}" Foreground="{StaticResource ErrorText}" VerticalAlignment="Center" Margin="10,0,0,0" />
                </WrapPanel>
            </Border>
            <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Background="{StaticResource PaneBackground}" Padding="8,2,8,5">
                <DockPanel LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="{Binding TimeRangeText}" VerticalAlignment="Center" FontWeight="SemiBold" />

                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="Window" Style="{StaticResource ToolLabel}" />
                        <ComboBox ItemsSource="{Binding BucketChoices}" SelectedItem="{Binding SelectedBucket}" ToolTip="Aggregation window for the chart and peaks" />
                        <TextBlock Text="{Binding BucketText}" Style="{StaticResource ToolLabel}" Margin="6,0,0,0" />
                        <TextBlock Text="Stack by" Style="{StaticResource ToolLabel}" />
                        <ComboBox ItemsSource="{Binding AllDimensions}" SelectedItem="{Binding StackBy}" MinWidth="140" />
                        <TextBlock Text="Message contains" Style="{StaticResource ToolLabel}" />
                        <TextBox Width="180" VerticalAlignment="Center" Text="{Binding MessageText, UpdateSourceTrigger=PropertyChanged, Delay=400}" />
                        <Button Content="Clear filters" Margin="12,0,0,0" VerticalAlignment="Center" Style="{StaticResource LinkButton}" Command="{Binding ClearFiltersCommand}" />
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- ================= Status bar ================= -->
            <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Border}" BorderThickness="0,1,0,0" Background="{StaticResource PaneBackground}" Padding="8,3">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Text="Querying…" Foreground="{StaticResource Muted}"
                               Visibility="{Binding IsQuerying, Converter={StaticResource BoolToVis}}" />
                    <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource Muted}" TextTrimming="CharacterEllipsis" />
                </DockPanel>
            </Border>

            <!-- ================= Body ================= -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="270" MinWidth="180" />
                    <ColumnDefinition Width="5" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Facet pane -->
                <Border Grid.Column="0" Background="{StaticResource PaneBackground}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,1,0">
                    <DockPanel>
                    <StackPanel DockPanel.Dock="Top" Margin="8,8,8,4">
                        <TextBlock Text="File name" Style="{StaticResource PaneHeader}" />
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="✕" Width="22" Margin="3,0,0,0" Padding="0" ToolTip="Clear the file name filter"
                                    Command="{Binding ClearFileNamePatternCommand}" />
                            <TextBox x:Name="FileNameBox" Text="{Binding FileNamePatternText, UpdateSourceTrigger=PropertyChanged, Delay=400}" VerticalContentAlignment="Center"
                                     IsEnabled="{Binding IsCaseOpen}">
                                <TextBox.ToolTip>
                                    <TextBlock>
                                        Filters every view to events whose file name matches.<LineBreak />
                                        * any characters, ? one character; case doesn't matter.<LineBreak />
                                        Without wildcards the whole name must match (report.docx).<LineBreak />
                                        ; separates alternatives, ! excludes:  *.docx;*.xlsx;!~$*
                                    </TextBlock>
                                </TextBox.ToolTip>
                            </TextBox>
                        </DockPanel>
                        <TextBlock Text="e.g.  file_00*.txt   *.docx;!~$*" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,2,0,0" />
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <ItemsControl ItemsSource="{Binding Facets}" Margin="6">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:FacetViewModel}">
                                    <Expander IsExpanded="{Binding IsExpanded}" Margin="0,0,0,4">
                                        <Expander.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <TextBlock Text="{Binding Label}" FontWeight="SemiBold" />
                                                <TextBlock Margin="6,0,0,0" Foreground="{StaticResource Accent}">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Text" Value="{Binding SelectedCount, StringFormat=({0})}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding SelectedCount}" Value="0">
                                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </StackPanel>
                                        </Expander.Header>
                                        <StackPanel Margin="18,2,0,0">
                                            <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,0,3"
                                                     Visibility="{Binding Searchable, Converter={StaticResource BoolToVis}}" ToolTip="Search values: text, or wildcards (* ? ; !) as in the File name box" />
                                            <ItemsControl ItemsSource="{Binding Values}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type vm:FacetValueViewModel}">
                                                        <DockPanel Margin="0,1">
                                                            <TextBlock DockPanel.Dock="Right" Text="{Binding Count, StringFormat=N0}" Foreground="{StaticResource Muted}" Margin="6,0,2,0" />
                                                            <CheckBox IsChecked="{Binding IsSelected}" ToolTip="{Binding Value}">
                                                                <TextBlock Text="{Binding Value}" TextTrimming="CharacterEllipsis" />
                                                            </CheckBox>
                                                        </DockPanel>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Expander>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                    </DockPanel>
                </Border>

                <GridSplitter Grid.Column="1" HorizontalAlignment="Stretch" Background="Transparent" />

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="260" MinHeight="120" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="*" MinHeight="120" />
                        <RowDefinition Height="5" />
                        <RowDefinition Height="220" MinHeight="60" />
                    </Grid.RowDefinitions>

                    <!-- Chart -->
                    <Grid Grid.Row="0">
                        <sp:WpfPlot x:Name="Chart" />
                        <TextBlock Text="Drag to select a time range · click a bar for its window · right-click to zoom out"
                                   HorizontalAlignment="Left" VerticalAlignment="Top" Margin="8,4" Foreground="{StaticResource Muted}" FontSize="11" />
                    </Grid>

                    <GridSplitter Grid.Row="1" HorizontalAlignment="Stretch" Background="{StaticResource Border}" />

                    <!-- Tree grid -->
                    <DockPanel Grid.Row="2">
                        <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="8,5">
                            <TextBlock Text="Group by" Style="{StaticResource ToolLabel}" Margin="0,0,4,0" />
                            <ComboBox ItemsSource="{Binding LevelChoices}" SelectedItem="{Binding Level1}" MinWidth="130" />
                            <TextBlock Text="▸" Style="{StaticResource ToolLabel}" Margin="6,0" />
                            <ComboBox ItemsSource="{Binding OptionalLevelChoices}" SelectedItem="{Binding Level2}" MinWidth="130" />
                            <TextBlock Text="▸" Style="{StaticResource ToolLabel}" Margin="6,0" />
                            <ComboBox ItemsSource="{Binding OptionalLevelChoices}" SelectedItem="{Binding Level3}" MinWidth="130" />
                            <TextBlock Text="▸ events" Style="{StaticResource ToolLabel}" Margin="6,0" />
                        </StackPanel>

                        <ListView x:Name="Tree" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}"
                                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                                  ScrollViewer.IsDeferredScrollingEnabled="False" BorderThickness="0,1,0,0" BorderBrush="{StaticResource Border}">
                            <ListView.ItemContainerStyle>
                                <Style TargetType="ListViewItem">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0,1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsEvent}" Value="True">
                                            <Setter Property="FontFamily" Value="Consolas" />
                                            <Setter Property="FontSize" Value="11.5" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsError}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource ErrorText}" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding IsMore}" Value="True">
                                            <Setter Property="Foreground" Value="{StaticResource Accent}" />
                                            <Setter Property="Cursor" Value="Hand" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </ListView.ItemContainerStyle>
                            <ListView.View>
                                <GridView>
                                    <GridViewColumn Header="Name" Width="580">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type vm:TreeRowViewModel}">
                                                <StackPanel Orientation="Horizontal" Margin="{Binding Indent, Converter={x:Static vm:Converters.LeftMargin}}" ToolTip="{Binding ToolTip}">
                                                    <Grid Width="16">
                                                        <ToggleButton Style="{StaticResource TreeToggle}" IsChecked="{Binding IsExpanded}"
                                                                      Visibility="{Binding CanExpand, Converter={StaticResource BoolToVis}}" />
                                                    </Grid>
                                                    <Rectangle Width="9" Height="9" Margin="2,0,5,0" Fill="{Binding Swatch}" VerticalAlignment="Center" />
                                                    <TextBlock Text="{Binding Text}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Count" Width="80">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding CountText}" HorizontalAlignment="Right" /></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Per min" Width="70">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding RateText}" HorizontalAlignment="Right" /></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Peak / window" Width="90">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate><TextBlock Text="{Binding PeakText}" HorizontalAlignment="Right" /></DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                    <GridViewColumn Header="Peak at" Width="98" DisplayMemberBinding="{Binding PeakAtText}" />
                                    <GridViewColumn Header="First" Width="98" DisplayMemberBinding="{Binding FirstText}" />
                                    <GridViewColumn Header="Last" Width="98" DisplayMemberBinding="{Binding LastText}" />
                                    <GridViewColumn Header="Trend" Width="110">
                                        <GridViewColumn.CellTemplate>
                                            <DataTemplate>
                                                <ctl:Sparkline Values="{Binding Trend}" Width="96" Height="14" Fill="#7FA6E6" />
                                            </DataTemplate>
                                        </GridViewColumn.CellTemplate>
                                    </GridViewColumn>
                                </GridView>
                            </ListView.View>
                        </ListView>
                    </DockPanel>

                    <GridSplitter Grid.Row="3" HorizontalAlignment="Stretch" Background="{StaticResource Border}" />

                    <!-- Event detail -->
                    <DockPanel Grid.Row="4">
                        <TextBlock DockPanel.Dock="Top" Text="Event detail" Style="{StaticResource PaneHeader}" Margin="8,4,8,2" />
                        <TextBox Text="{Binding DetailText, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11.5"
                                 VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" BorderThickness="0,1,0,0"
                                 BorderBrush="{StaticResource Border}" Padding="6,4" TextWrapping="NoWrap" />
                    </DockPanel>
                </Grid>
            </Grid>
        </DockPanel>

        <!-- ================= Busy overlay ================= -->
        <Grid Background="#80FFFFFF" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
            <Border Background="White" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="4"
                    Padding="24,18" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="380">
                <StackPanel>
                    <TextBlock Text="{Binding BusyText}" TextWrapping="Wrap" Margin="0,0,0,10" />
                    <ProgressBar IsIndeterminate="True" Height="4" />
                    <Button Content="Cancel" HorizontalAlignment="Right" Margin="0,12,0,0" Padding="14,3" Command="{Binding CancelCommand}" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
