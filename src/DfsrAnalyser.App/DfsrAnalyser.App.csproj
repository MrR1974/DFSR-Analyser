<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <AssemblyName>DfsrAnalyser</AssemblyName>
    <RootNamespace>DfsrAnalyser.App</RootNamespace>
    <ServerGarbageCollection>true</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <!-- ScottPlot.WPF depends on SkiaSharp.Views.WPF, which only declares .NET Framework targets but runs on .NET. -->
    <NoWarn>$(NoWarn);NU1701</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="ScottPlot.WPF" Version="5.1.59" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DfsrAnalyser.Core\DfsrAnalyser.Core.csproj" />
    <ProjectReference Include="..\DfsrAnalyser.Collection\DfsrAnalyser.Collection.csproj" />
  </ItemGroup>

</Project>
