<Window x:Class="DfsrAnalyser.App.CollectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:DfsrAnalyser.App.ViewModels"
        Title="Collect from servers" Width="1100" Height="820" MinWidth="800" MinHeight="600"
        WindowStartupLocation="CenterOwner" Background="White">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="160" />
        </Grid.RowDefinitions>

        <!-- Connection -->
        <GroupBox Grid.Row="0" Header="Directory and credentials" Padding="6">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Domain or DC" VerticalAlignment="Center" Width="110" />
                    <TextBox Width="260" Text="{Binding Domain, UpdateSourceTrigger=PropertyChanged}" ToolTip="Leave blank for this computer's domain" />
                    <TextBlock Text="Profile" VerticalAlignment="Center" Margin="24,0,8,0" />
                    <ComboBox Width="200" ItemsSource="{Binding Profiles}" SelectedItem="{Binding SelectedProfile}" DisplayMemberPath="Name"
                              ToolTip="Load a saved set of servers" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                    <CheckBox Content="Use alternate credentials" IsChecked="{Binding UseAlternateCredentials}" VerticalAlignment="Center" Width="180" />
                    <TextBlock Text="User (DOMAIN\user)" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Width="190" Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding UseAlternateCredentials}" />
                    <TextBlock Text="Password" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <PasswordBox x:Name="Password" Width="170" IsEnabled="{Binding UseAlternateCredentials}" />
                    <TextBlock Text="Not saved anywhere." Foreground="#6B7280" VerticalAlignment="Center" Margin="10,0,0,0" />
                </StackPanel>
            </StackPanel>
        </GroupBox>

        <!-- Discovery -->
        <GroupBox Grid.Row="1" Header="Replication groups in AD" Padding="6" Margin="0,8,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                    <Button Content="Discover" Padding="14,2" Command="{Binding DiscoverCommand}" />
                    <TextBlock Text="{Binding DiscoveryText}" Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#6B7280" />
                </StackPanel>
                <ItemsControl ItemsSource="{Binding Groups}" Margin="0,6,0,0" MaxHeight="120">
                    <ItemsControl.Template>
                        <ControlTemplate><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer></ControlTemplate>
                    </ItemsControl.Template>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:GroupRowViewModel}">
                            <CheckBox IsChecked="{Binding IsSelected}" Margin="0,1">
                                <TextBlock>
                                    <Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold" />
                                    <Run Text="  " />
                                    <Run Text="{Binding MembersText, Mode=OneWay}" Foreground="#6B7280" />
                                </TextBlock>
                            </CheckBox>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </DockPanel>
        </GroupBox>

        <!-- Servers -->
        <GroupBox Grid.Row="2" Header="Servers" Padding="6" Margin="0,8,0,0">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,6">
                    <TextBox Width="300" Text="{Binding NewServer, UpdateSourceTrigger=PropertyChanged}" ToolTip="Server name(s), comma separated">
                        <TextBox.InputBindings>
                            <KeyBinding Key="Enter" Command="{Binding AddServerCommand}" />
                        </TextBox.InputBindings>
                    </TextBox>
                    <Button Content="Add" Padding="14,2" Margin="6,0,0,0" Command="{Binding AddServerCommand}" />
                    <Button Content="Remove unticked" Padding="10,2" Margin="6,0,0,0" Command="{Binding RemoveExcludedCommand}" />
                    <TextBlock Text="Log folder blank = \\host\admin$\debug" Foreground="#6B7280" VerticalAlignment="Center" Margin="12,0,0,0" />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Servers}" AutoGenerateColumns="False" CanUserAddRows="False" HeadersVisibility="Column"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="#ECEEF1">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Header="" Binding="{Binding Include, UpdateSourceTrigger=PropertyChanged}" Width="30" />
                        <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="130" />
                        <DataGridTextColumn Header="Host" Binding="{Binding Host}" Width="200" />
                        <DataGridTextColumn Header="Log folder" Binding="{Binding LogFolder}" Width="200" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="70" IsReadOnly="True" />
                        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="*" IsReadOnly="True" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </GroupBox>

        <!-- Range and options -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,10,0,0">
            <TextBlock Text="Time range" VerticalAlignment="Center" Margin="0,0,8,0" />
            <ComboBox Width="230" ItemsSource="{Binding Ranges}" SelectedItem="{Binding SelectedRange}" />
            <StackPanel Orientation="Horizontal" Visibility="{Binding IsCustomRange, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="from" VerticalAlignment="Center" Margin="10,0,4,0" />
                <TextBox Width="130" Text="{Binding CustomFrom, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock Text="to" VerticalAlignment="Center" Margin="8,0,4,0" />
                <TextBox Width="130" Text="{Binding CustomTo, UpdateSourceTrigger=PropertyChanged}" ToolTip="Blank = now" />
            </StackPanel>
            <CheckBox Content="Also collect the DFS Replication event log" IsChecked="{Binding IncludeEventLog}" VerticalAlignment="Center" Margin="20,0,0,0" />
        </StackPanel>

        <DockPanel Grid.Row="4" Margin="0,10,0,8" LastChildFill="False">
            <CheckBox DockPanel.Dock="Left" Content="Save as profile" IsChecked="{Binding SaveProfile}" VerticalAlignment="Center" />
            <TextBox DockPanel.Dock="Left" Width="180" Margin="8,0,0,0" Text="{Binding ProfileName, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding SaveProfile}" />

            <Button DockPanel.Dock="Right" Content="Close" Padding="16,3" Margin="6,0,0,0" IsCancel="True" Click="OnClose" />
            <Button DockPanel.Dock="Right" Content="Collect" Padding="16,3" Margin="6,0,0,0" Command="{Binding CollectCommand}" FontWeight="SemiBold" />
            <Button DockPanel.Dock="Right" Content="Dry run" Padding="16,3" Margin="6,0,0,0" Command="{Binding DryRunCommand}" ToolTip="List what would be copied, without copying" />
            <Button DockPanel.Dock="Right" Content="Test connection" Padding="16,3" Command="{Binding TestCommand}" />
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="0,0,16,0" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVis}}">
                <TextBlock Text="{Binding ProgressText}" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button Content="Cancel" Padding="10,2" Command="{Binding CancelCommand}" />
            </StackPanel>
        </DockPanel>

        <DockPanel Grid.Row="5">
            <DockPanel DockPanel.Dock="Top">
                <Button DockPanel.Dock="Right" Content="Open log file" Style="{StaticResource LinkButton}" Command="{Binding OpenLogCommand}" />
                <TextBlock Text="{Binding LogPath, StringFormat=Diagnostic log: {0}}" Foreground="#6B7280" TextTrimming="CharacterEllipsis" />
            </DockPanel>
            <TextBox x:Name="LogBox" Text="{Binding Log, Mode=OneWay}" IsReadOnly="True" FontFamily="Consolas" FontSize="11" Margin="0,4,0,0"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap" TextChanged="OnLogChanged" />
        </DockPanel>
    </Grid>
</Window>
