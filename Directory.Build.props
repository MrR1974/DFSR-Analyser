<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Authors>Mark Renoden</Authors>
    <Product>DFSR Analyser</Product>
    <Version>1.0.0</Version>
    <Company>Mark Renoden</Company>
    <Copyright>Copyright (c) 2026 Mark Renoden</Copyright>
    <Description>Imports or collects DFSR debug logs and charts event rates over time.</Description>
  </PropertyGroup>
</Project>
